{
  "openapi": "3.0.3",
  "info": {
    "title": "xero-mirror API",
    "version": "0.1.0",
    "description": "xero-mirror 把 Xero Accounting 資料單向鏡射到本地 MySQL，提供 webhook 接收與健康檢查端點。本服務端點只允許 GET／POST，其他方法一律回 405 並帶 Allow header；未知路徑回 404。"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "健康檢查",
        "description": "只對資料庫做 ping，不涉及業務邏輯。DB 可連回 200，失敗先記錄警告再回 503。",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "資料庫連線正常。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOk"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "503": {
            "description": "資料庫 ping 失敗。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnhealthy"
                }
              }
            }
          }
        }
      }
    },
    "/webhook": {
      "post": {
        "summary": "Xero webhook 回呼",
        "description": "以 HMAC-SHA256 對 raw body 計算簽章後 base64，與 `x-xero-signature` header 做 constant-time 比對；簽章驗證前不解析 body。驗簽通過後才解析事件、去重並入列 `webhook_events` 與 `sync_jobs`。驗簽失敗回 401、body 或事件不合法回 400、入列失敗回 500 讓 Xero 重送。",
        "operationId": "postWebhook",
        "parameters": [
          {
            "name": "x-xero-signature",
            "in": "header",
            "required": true,
            "description": "Xero 以 webhook signing key 對 raw body 計算的 HMAC-SHA256 簽章（base64 編碼）。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Xero webhook 事件批次；JSON tag 沿用 Xero 原樣 camelCase。",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "驗簽通過且事件已入列（或全部略過）；回應 body 為空。"
          },
          "400": {
            "description": "raw body 超過上限、無法解析 JSON，或 `eventDateUtc` 格式不合法。"
          },
          "401": {
            "description": "`x-xero-signature` 與 HMAC-SHA256 計算結果不符。"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "500": {
            "description": "寫入 `webhook_events`／`sync_jobs` 失敗；刻意回 500 讓 Xero 重送，避免事件遺失。"
          }
        }
      }
    },
    "/api/status/sync": {
      "get": {
        "summary": "同步狀態",
        "description": "查詢各 tenant × entity 的 `sync_state` 記錄，支援 `tenant` 與 `entity` query params 過濾。",
        "operationId": "getStatusSync",
        "parameters": [
          {
            "name": "tenant",
            "in": "query",
            "required": false,
            "description": "過濾特定 tenant_id；空值代表不過濾。",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entity",
            "in": "query",
            "required": false,
            "description": "過濾特定 entity；空值代表不過濾。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "同步狀態清單。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusSyncResponse"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/api/status/jobs": {
      "get": {
        "summary": "同步佇列統計",
        "description": "查詢 `sync_jobs` 各狀態（pending、processing、failed）的筆數與總數。",
        "operationId": "getStatusJobs",
        "responses": {
          "200": {
            "description": "同步佇列統計。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusJobsResponse"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/api/status/tenants": {
      "get": {
        "summary": "Tenant 狀態（含 Rate Limit 配額）",
        "description": "查詢全部 tenant 的狀態與 rate limit 配額剩餘量；rate limit 由 Xero API response headers 非同步更新。",
        "operationId": "getStatusTenants",
        "responses": {
          "200": {
            "description": "Tenant 清單與 rate limit 配額。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusTenantsResponse"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    },
    "/api/status/webhooks": {
      "get": {
        "summary": "Webhook 事件統計",
        "description": "查詢 `webhook_events` 的 pending、processed 與總筆數。",
        "operationId": "getStatusWebhooks",
        "responses": {
          "200": {
            "description": "Webhook 事件統計。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusWebhooksResponse"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthOk": {
        "type": "object",
        "description": "健康檢查成功回應。",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        }
      },
      "HealthUnhealthy": {
        "type": "object",
        "description": "健康檢查失敗回應。",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unhealthy"
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "通用錯誤回應；`error` 為繁體中文訊息。",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "請求參數不合法"
          }
        }
      },
      "WebhookPayload": {
        "type": "object",
        "description": "Xero webhook payload 概要；欄位名稱照 Xero 原樣 camelCase。",
        "required": [
          "firstEventSequence",
          "lastEventSequence",
          "entropy",
          "events"
        ],
        "properties": {
          "firstEventSequence": {
            "type": "integer",
            "description": "本批次第一個事件的序號。"
          },
          "lastEventSequence": {
            "type": "integer",
            "description": "本批次最後一個事件的序號。"
          },
          "entropy": {
            "type": "string",
            "description": "Xero 提供的隨機值，用於降低重放風險。"
          },
          "events": {
            "type": "array",
            "description": "事件清單；未支援的 `eventCategory` 會略過而不影響其他事件。",
            "items": {
              "$ref": "#/components/schemas/WebhookEvent"
            }
          }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "description": "單一 Xero webhook 事件。",
        "required": [
          "tenantId",
          "tenantType",
          "resourceUrl",
          "resourceId",
          "eventDateUtc",
          "eventType",
          "eventCategory"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "description": "Xero tenant ID；缺失時該事件略過。"
          },
          "tenantType": {
            "type": "string",
            "description": "tenant 類型，例如 `ORGANISATION`。"
          },
          "resourceUrl": {
            "type": "string",
            "description": "資源的 API 路徑。"
          },
          "resourceId": {
            "type": "string",
            "description": "資源的 Xero GUID；與 `eventDateUtc` 合併做去重鍵。缺失時該事件略過。"
          },
          "eventDateUtc": {
            "type": "string",
            "description": "事件發生時間（UTC，無時區標記，例如 `2026-05-01T00:12:34.567`）。格式不合法時整批回 400。"
          },
          "eventType": {
            "type": "string",
            "description": "事件類型；保留 `CREATE`／`UPDATE`／`DELETE` 作為列舉，其他值會被記為 `unknown`，不影響事件入列。",
            "enum": [
              "CREATE",
              "UPDATE",
              "DELETE"
            ]
          },
          "eventCategory": {
            "type": "string",
            "description": "事件分類；目前支援 `INVOICE`、`CONTACT`、`CREDITNOTE`、`PAYMENT`，其他分類（如 `SUBSCRIPTION`）略過不寫 DB。",
            "enum": [
              "INVOICE",
              "CONTACT",
              "CREDITNOTE",
              "PAYMENT",
              "SUBSCRIPTION"
            ]
          }
        }
      },
      "StatusSyncResponse": {
        "type": "object",
        "description": "同步狀態查詢回應。",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "description": "各 tenant × entity 的同步狀態清單。",
            "items": {
              "$ref": "#/components/schemas/StatusSyncItem"
            }
          }
        }
      },
      "StatusSyncItem": {
        "type": "object",
        "description": "單一 tenant × entity 的同步狀態。",
        "required": ["tenant_id", "entity", "status"],
        "properties": {
          "tenant_id": {
            "type": "string",
            "description": "Xero tenant ID。"
          },
          "entity": {
            "type": "string",
            "description": "實體名稱（invoices、contacts、accounts、creditnotes、payments）。"
          },
          "cursor_time": {
            "type": "string",
            "format": "date-time",
            "description": "增量同步水位（UTC）；首次同步前可能為 null。"
          },
          "last_run_at": {
            "type": "string",
            "format": "date-time",
            "description": "最後一次同步執行時間（UTC）；從未執行過則為 null。"
          },
          "status": {
            "type": "string",
            "description": "同步狀態（running、ok、failed）。"
          }
        }
      },
      "StatusJobsResponse": {
        "type": "object",
        "description": "同步佇列統計回應。",
        "required": ["pending", "processing", "failed", "total"],
        "properties": {
          "pending": {
            "type": "integer",
            "description": "待處理的 job 筆數。"
          },
          "processing": {
            "type": "integer",
            "description": "處理中的 job 筆數。"
          },
          "failed": {
            "type": "integer",
            "description": "失敗的 job 筆數。"
          },
          "total": {
            "type": "integer",
            "description": "全部 job 筆數（pending + processing + failed）。"
          }
        }
      },
      "StatusTenantsResponse": {
        "type": "object",
        "description": "Tenant 狀態與 rate limit 配額回應。",
        "required": ["items"],
        "properties": {
          "items": {
            "type": "array",
            "description": "全部 tenant 清單。",
            "items": {
              "$ref": "#/components/schemas/StatusTenantItem"
            }
          }
        }
      },
      "StatusTenantItem": {
        "type": "object",
        "description": "單一 tenant 的狀態與 rate limit 配額。",
        "required": ["tenant_id", "tenant_name", "auth_status"],
        "properties": {
          "tenant_id": {
            "type": "string",
            "description": "Xero tenant ID。"
          },
          "tenant_name": {
            "type": "string",
            "description": "Tenant 名稱（Xero 組織名稱）。"
          },
          "auth_status": {
            "type": "string",
            "description": "授權狀態（active、expired、revoked）。"
          },
          "token_expiry": {
            "type": "string",
            "format": "date-time",
            "description": "Access token 過期時間（UTC）；尚未授權則為 null。"
          },
          "day_limit_remaining": {
            "type": "integer",
            "description": "剩餘每日配額（per tenant）；尚未收到 Xero response 則為 null。"
          },
          "minute_limit_remaining": {
            "type": "integer",
            "description": "剩餘每分鐘配額（per tenant）；尚未收到 Xero response 則為 null。"
          },
          "app_minute_limit_remaining": {
            "type": "integer",
            "description": "剩餘全 app 每分鐘配額（跨所有 tenant）；尚未收到 Xero response 則為 null。"
          },
          "rate_limit_snapshot_at": {
            "type": "string",
            "format": "date-time",
            "description": "Rate limit 快照時間（UTC）；尚未收到 Xero response 則為 null。"
          },
          "last_sync_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "最後一次成功同步時間（UTC）；從未同步過則為 null。"
          }
        }
      },
      "StatusWebhooksResponse": {
        "type": "object",
        "description": "Webhook 事件統計回應。",
        "required": ["pending", "processed", "total"],
        "properties": {
          "pending": {
            "type": "integer",
            "description": "待處理的事件筆數（processed_at IS NULL）。"
          },
          "processed": {
            "type": "integer",
            "description": "已處理的事件筆數（processed_at IS NOT NULL）。"
          },
          "total": {
            "type": "integer",
            "description": "全部事件筆數。"
          }
        }
      }
    },
    "responses": {
      "MethodNotAllowed": {
        "description": "方法不允許；本服務端點只接受 GET／POST，回應帶 `Allow` header 標示允許的方法。",
        "headers": {
          "Allow": {
            "description": "允許的 HTTP 方法。",
            "schema": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
