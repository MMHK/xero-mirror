# xero-mirror 環境變數範例
# 複製為 .env 後填入真值（.env 已被 .gitignore 忽略，勿提交任何真實憑證）
# 必填變數缺一個，服務就會輸出 slog.Error 並以 exit code 1 結束

# Xero app 的 client id
XERO_CLIENT_ID=

# Xero app 的 client secret
XERO_CLIENT_SECRET=

# 授權回呼網址，必須是 http://localhost:{port}/callback（port 3000-9000）
# 例：http://localhost:8080/callback
# 禁用 127.0.0.1（Xero 註冊不匹配會直接失敗）
XERO_REDIRECT_URI=

# webhook signing key（Xero 後台取得，用於 HMAC-SHA256 驗簽）
XERO_WEBHOOK_KEY=

# AES-256-GCM 金鑰，必須是 32 bytes 的 base64
# 產生方式：openssl rand -base64 32
XERO_TOKEN_ENC_KEY=

# MySQL 連線字串
# 例：user:pass@tcp(127.0.0.1:3307)/xero_mirror?parseTime=true&loc=UTC
# 不可開啟 clientFoundRows（webhook 去重依賴 affected-rows 語意）
# 本機 dev：先用 `docker compose up -d` 啟動 MySQL（port 3307），再用下方範例
MYSQL_DSN=root:root@tcp(127.0.0.1:3307)/xero_mirror?parseTime=true&loc=UTC

# cron 表示式（serve 常駐時定期觸發增量同步）
# 例：0 */2 * * *
SYNC_CRON=

# serve 監聽位址
# 例：:8080
HTTP_ADDR=

# 選用：每 tenant 每日 Xero API 呼叫上限
# 留空則採程式內建預設值 DefaultDailyCallLimit（1000）；有值必須是正整數
XERO_DAILY_CALL_LIMIT=

# 選用：sync job queue 每次 poll 拉取的 sync_jobs 上限
# 留空則採預設值 100；有值必須是正整數
SYNC_JOB_BATCH_SIZE=

# 選用：sync job queue 佇列為空時的等待間隔（毫秒）
# 有 pending jobs 時持續處理不等待；佇列清空後才進入冷卻期
# 留空則採預設值 5000（5 秒）；有值必須是正整數
SYNC_JOB_POLL_INTERVAL=

# 選用：日誌等級（debug|info|warn|error，預設 info）
# 大小寫不敏感；非法值啟動即報錯（例：設定 debug 可看到分塊寫入的 debug log）
LOG_LEVEL=

# 選用：是否啟用 Swagger 文件端點（true|false，預設 false）
# 大小寫不敏感；非法值啟動即報錯（例：設定 true 可於 /swagger 檢視 Status API）
SWAGGER_ENABLED=

# 選用：靜態檔案目錄路徑（預設 "web"）
# 部署時可指定絕對路徑或相對路徑，用於服務前端頁面
WEB_DIR=/app/web

# 選用：Live Xero 整合測試（pkg/xero/live_test.go）
# 未設定時相關測試一律 skip；access token 效期約 30 分鐘，需手動更新
TEST_XERO_TENANT_ID=
TEST_XERO_ACCESS_TOKEN=

# 選用：DB 整合測試（pkg/store／pkg/sync／pkg/handler）
# 未設定時 DB 測試一律 skip；DSN 的 database 名稱必須含 _test（防止誤刪正式資料）
# 例：root:root@tcp(127.0.0.1:13315)/xero_mirror_test?parseTime=true&loc=UTC（docker-compose.test.yml）
TEST_MYSQL_DSN=

# =============================================================================
# Zoho Auth Gate（選用）
# 啟用後，敏感路由（/api/setup/*、/api/status/*）需要 Zoho 身份驗證才能存取
# =============================================================================

# 選用：是否啟用 Zoho Auth Gate（true|false，預設 false）
# 大小寫不敏感；啟用時需同時設定 ZOHO_CLIENT_ID、ZOHO_CLIENT_SECRET、ZOHO_SESSION_SECRET
ZOHO_AUTH_ENABLED=

# ZOHO_AUTH_ENABLED=true 時必填：Zoho OAuth Client ID
# 到 https://api-console.zoho.com 建立 Self Client 取得
ZOHO_CLIENT_ID=

# ZOHO_AUTH_ENABLED=true 時必填：Zoho OAuth Client Secret
ZOHO_CLIENT_SECRET=

# 選用：Zoho Accounts domain（預設 accounts.zoho.com）
# 根據您的 Zoho 資料中心選擇：
# - accounts.zoho.com（美國）
# - accounts.zoho.eu（歐洲）
# - accounts.zoho.in（印度）
# - accounts.zoho.com.au（澳洲）
# - accounts.zoho.com.cn（中國）
ZOHO_ACCOUNTS_DOMAIN=

# 選用：允許登入的 email domain 清單（逗號分隔）
# 未設定時允許任何已認證的 Zoho 使用者
# 例：example.com,company.org
ZOHO_ALLOWED_DOMAINS=

# ZOHO_AUTH_ENABLED=true 時必填：Session cookie 簽名金鑰
# 必須是 32 bytes 的 base64
# 產生方式：openssl rand -base64 32
ZOHO_SESSION_SECRET=
